# KeepAI Environment Configuration
PORT=5000

# Optional: Google Gemini API Key for Server-Side AI
# If not provided, KeepAI uses its intelligent offline role-aware engine
GEMINI_API_KEY=

# Optional: MongoDB connection string (if switching from local JSON store to MongoDB)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/keepai

{
  "name": "keep-ai",
  "version": "2.0.0",
  "description": "KeepAI - Intelligent AI Second Brain & Career Workspace built with React, Node.js, Express, and Google Gemini",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"CLIENT,SERVER\" -c \"cyan.bold,yellow.bold\" \"npm run client\" \"npm run server:dev\"",
    "client": "vite",
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "vite": "^5.4.2"
  }
}
